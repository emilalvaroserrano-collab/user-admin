# Server-side configuration only. Never use NEXT_PUBLIC_ for credentials.
# Local development. In Vercel set APP_ORIGIN to your actual HTTPS production origin.
ZENDESK_SUBDOMAIN=managetechservices-16737
# Optional expected administrator email for local client_credentials mode.
ZENDESK_OWNER_EMAIL=
ZENDESK_CLIENT_ID=managetech
ZENDESK_CLIENT_SECRET=
ZENDESK_SCOPE="read write"
APP_ORIGIN=http://localhost:3000
# openssl rand -hex 32
SESSION_SECRET=
# Optional loopback-only development mode (never enabled on Vercel).
ZENDESK_AUTH_MODE=authorization_code
ZENDESK_ORDER_OBJECT_KEY=
ZENDESK_PRODUCT_OBJECT_KEY=
